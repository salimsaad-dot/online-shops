NODE_ENV=development
PORT=4000

# Local XAMPP MariaDB. Production (Aiven): mysql://user:pass@host:port/db?ssl=true
DATABASE_URL="mysql://root:@localhost:3306/online_shops"

# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Shops resolve as <slug>.<PLATFORM_DOMAIN>; super-admin panel lives on PLATFORM_HOST
PLATFORM_DOMAIN=localhost
PLATFORM_HOST=localhost:3001
# Dev only: shop to use when the host matches nothing
DEFAULT_SHOP_SLUG=
# Extra comma-separated CORS origins (not needed when using the Next.js proxy)
CORS_ORIGINS=
# Shared secret with the frontend proxy (same value as frontend INTERNAL_PROXY_SECRET). Required in production.
INTERNAL_PROXY_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
