# Where the Express API lives. Server-side only (the browser always calls same-origin /api).
BACKEND_URL=http://localhost:4000
# Host that serves the super-admin platform panel (must match backend PLATFORM_HOST)
PLATFORM_HOST=localhost:3001
# Same value, exposed to the browser (used to build shop links in the platform panel)
NEXT_PUBLIC_PLATFORM_HOST=localhost:3001
# Shared secret with the backend (same value as backend INTERNAL_PROXY_SECRET). Required in production.
INTERNAL_PROXY_SECRET=
